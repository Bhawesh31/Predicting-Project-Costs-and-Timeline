# POWERGRID Backend — Environment Variables
# ─────────────────────────────────────────────────────────────
# Default uses SQLite (no setup needed, a .db file is created automatically)
# To use PostgreSQL instead, uncomment the line below and fill in your details

DATABASE_URL=sqlite:///./powergrid.db

# PostgreSQL (for production):
# DATABASE_URL=postgresql://your_user:your_password@localhost:5432/powergrid